{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genetech.tools/schemas/agent-card.schema.json",
  "title": "GeneTech A2A Agent Card",
  "version": "1.0.0",
  "description": "Agent-to-Agent Card (Google A2A 0.3 / Linux Foundation 2025-04). GeneTech 作为 A2A 网络节点的身份声明。",
  "type": "object",
  "required": ["name", "description", "url", "version", "capabilities", "skills"],
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "url": { "type": "string", "format": "uri" },
    "documentationUrl": { "type": "string", "format": "uri" },
    "version": { "type": "string" },
    "protocolVersion": { "type": "string" },
    "capabilities": {
      "type": "object",
      "required": ["streaming", "pushNotifications", "stateTransitionHistory"],
      "properties": {
        "streaming": { "type": "boolean" },
        "pushNotifications": { "type": "boolean" },
        "stateTransitionHistory": { "type": "boolean" }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "schemes": { "type": "array", "items": { "type": "string" } },
        "credentials": { "type": "string" }
      }
    },
    "provider": {
      "type": "object",
      "properties": {
        "organization": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "examples": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "securitySchemes": { "type": "object", "additionalProperties": true },
    "security": { "type": "array" }
  }
}
