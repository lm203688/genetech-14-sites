# 本地开发环境变量模板
# 用法：复制本文件为同目录 .dev.vars 并填入真实值。
# .dev.vars 已被仓库根 .gitignore 忽略，绝不会被提交到公开仓库。
# （生产环境请用 `npx wrangler secret put <NAME>` 注入，不要依赖本文件。）

# 虎皮椒国内支付（微信/支付宝）—— 在虎皮椒商户后台获取
HUPIJIAO_APP_ID=your_app_id_here
HUPIJIAO_APP_SECRET=your_app_secret_here

# 以下 cfut_ 令牌用途待确认（非虎皮椒官方 API 必填项），如确认属于虎皮椒子通道，
# 应按 unified-license/README.md 的 HUPIJIAO_CHANNELS 配置，而非本占位变量。
HUPIJIAO_UNKNOWN_TOKENS=

# 管理员发行密钥（/api/admin/issue 手动发卡用）；生产务必通过 wrangler secret put 设置
ADMIN_SECRET=change_me
