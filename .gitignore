# Dependencies
node_modules/
package-lock.json

# Environment
.env
.env.local
.env.*.local
.secrets/
.dev.vars

# Build output
dist/
build/
.wrangler/
# 静态站点生成产物（由 tools/build-site.mjs 在 CI 中重建，不入库）
_site/
_site_test/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary
tmp/
temp/
*.tmp
*.tmp.json

# Trae work files
.trae-cn/

# Large data files (use Git LFS if needed)
*.zip
*.tar.gz
*.7z

# Command center reports (generated daily)
command-center/status-*.json

# GitHub config (contains no token but exclude for safety)
.env.github
.env.*.github

# WorkBuddy local memory / state (must NOT be committed)
.workbuddy/

# Local agent runtime state
.claude/
.aider/

# Local pipeline runtime artifacts (regenerated by automation)
.poc/
promotion-assets/

# LLM bridge local config (contains base URL + API key, never commit)
config/llm-bridge.local.json

# Transient shell error logs (e.g. from push/retry loops)
err.log

# 外来项目资料暂存区（aishield 等，用户手动移走，不进本仓库）
external-projects/

# MCP server verification scratch (generated by local stdio smoke tests, safe to delete)
mcp_init.json
mcp_out.log
mcp-server/mcp_*.jsonl
mcp-server/mcp_*.log
tmp/verify-scratch/

# Unified-license local smoke/check scratch (generated during local verification)
unified-license/_chk.mjs
unified-license/_smoke.mjs
unified-license/_test_order.mjs
unified-license/_test_verify.mjs

# ============================================================
# 引擎目录（2026-08-21 混合回退模式）：operations-plan/、tools/build-site.mjs、
# shared/、unified-license/、api-guard/ 保持入库，作为 CI 的公开兜底引擎——
# 私有仓 genetech-14-engine 可用时优先（workflows 经 ENGINE_TOKEN 克隆到 engine/），
# 不可用时回退仓内副本，确保「推送闭源 refactor 后 Secrets 未配」不再导致全线停摆。
# ============================================================
# CI 运行时从私有仓克隆的引擎（防御：勿被机器人提交步骤写回公开仓）
engine/

# 审计日志目录（运行时生成，.gitignore 防泄漏；demo 数据在 .proposals/ .active/）
audit/

# scratch scripts from prior sessions（不入库，避免混淆）
tools/_*.mjs
tools/_*.py
tools/cf_*.mjs
