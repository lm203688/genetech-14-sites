{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Entity Schema",
  "description": "Valid entity structure for Genetech knowledge graph",
  "type": "object",
  "required": [
    "id",
    "name",
    "source",
    "abstract",
    "url",
    "tags",
    "confidence",
    "sites",
    "addedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Entity identifier (e.g., doi:10.3920/9789086867783_098)"
    },
    "name": {
      "type": "string",
      "description": "Entity name/title"
    },
    "source": {
      "type": "string",
      "description": "Data source (e.g., crossref, openalex, pubmed, arxiv)"
    },
    "abstract": {
      "type": "string",
      "description": "Abstract text"
    },
    "url": {
      "type": "string",
      "description": "URL to the entity"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Author names"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Topic tags"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence score"
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Site names this entity belongs to"
    },
    "publishedDate": {
      "type": "string",
      "description": "Publication date (ISO 8601 or YYYY-MM-DD)"
    },
    "addedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When this entity was added to the system"
    },
    "doi": {
      "type": "string",
      "description": "DOI if available"
    },
    "zone_note": {
      "type": "string",
      "description": "Optional geographic / agronomic zone note (crop-adapt-db E2). Reserved for agritech + life-science domains. Optional to avoid blocking existing 152 station data; populated as data grows."
    }
  }
}