{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Knowledge Graph Schema",
  "description": "Valid knowledge graph structure for Genetech",
  "type": "object",
  "required": [
    "version",
    "builtAt",
    "schema",
    "stats",
    "nodes",
    "edges"
  ],
  "properties": {
    "version": {
      "type": "number",
      "description": "Knowledge graph version number"
    },
    "builtAt": {
      "type": "string",
      "format": "date-time",
      "description": "Built timestamp"
    },
    "schema": {
      "type": "string",
      "description": "Schema identifier (e.g., genetech-knowledge-graph/v3)"
    },
    "stats": {
      "type": "object",
      "properties": {
        "stations": { "type": "number" },
        "uniqueEntities": { "type": "number" },
        "crossSiteEntities": { "type": "number" },
        "tagKinds": { "type": "number" },
        "nodes": { "type": "number" },
        "edges": { "type": "number" },
        "crossSiteEdges": { "type": "number" },
        "sharedTagEdges": { "type": "number" },
        "coTopicEdges": { "type": "number" },
        "entityEntityEdges": { "type": "number" },
        "pairCandidates": { "type": "number" },
        "citationEdges": { "type": "number" },
        "citationEdgeShare": { "type": "number" },
        "stubNodes": { "type": "number" }
      },
      "additionalProperties": true
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "station": { "type": "string" },
          "abstract": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "metadata": { "type": "object" },
          "first_seen_at": { "type": "string", "format": "date-time" },
          "last_updated_at": { "type": "string", "format": "date-time" },
          "version": { "type": "number" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "relation", "tier"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "relation": {
            "type": "string",
            "description": "Edge relation type. For PROV-O aligned citation edges: 'prov:wasDerivedFrom' (citing→cited); legacy: 'citation', 'shared_tag', 'co_topic', 'entity_entity', 'reference'"
          },
          "weight": { "type": "number" },
          "tier": {
            "type": "integer",
            "enum": [1, 2, 3, 4, 5],
            "description": "Source credibility tier (F10): 1=authoritative-manual, 2=peer-reviewed, 3=high-confidence-derived, 4=medium-confidence-inferred, 5=low-confidence-speculative"
          },
          "first_seen_at": { "type": "string", "format": "date-time" },
          "firstSeenAt": { "type": "string", "format": "date-time" },
          "last_seen_at": { "type": "string", "format": "date-time" },
          "lastSeenAt": { "type": "string", "format": "date-time" },
          "valid_from": { "type": "string", "format": "date-time" },
          "valid_to": {
            "description": "Null if currently valid",
            "oneOf": [
              { "type": "string", "format": "date-time" },
              { "type": "null" }
            ]
          },
          "prov": {
            "type": "object",
            "description": "Phase 3 PROV-O semantic annotations. Maps the edge to W3C PROV-O primitives (https://www.w3.org/TR/prov-o/). Optional but recommended for citation edges.",
            "properties": {
              "entity": {
                "type": "string",
                "description": "The activity/entity this edge documents. For citation edges, this is the citing paper (source)."
              },
              "activity": {
                "type": "string",
                "description": "prov:Activity ID — the publishing event that produced the entity. Convention: `genetech:activity:{doi}:published`."
              },
              "agent": {
                "type": "string",
                "description": "prov:Agent ID — the curator/agent responsible for the edge. Convention: `genetech:agent:pipeline:{pipelineName}` (e.g. pipeline-citation-edges-refs)."
              },
              "wasDerivedFrom": {
                "type": "string",
                "description": "prov:wasDerivedFrom — cites the entity that influenced this one. For citation edges, this is the cited paper (target)."
              },
              "used": {
                "type": "string",
                "description": "prov:used — the entity consumed by the activity (e.g. the cited paper consumed during writing)."
              },
              "wasGeneratedAt": {
                "type": "string",
                "format": "date-time",
                "description": "prov:wasGeneratedAt — when the edge was derived/created by our pipeline (equals resolvedAt)."
              },
              "wasAssociatedWith": {
                "type": "string",
                "description": "prov:wasAssociatedWith — the qualifier linking activity to agent. Convention: `genetech:attribution:{tier}:{method}`."
              },
              "hadTime": {
                "type": "string",
                "description": "prov:TimeInterval qualifier — ISO 8601 interval string covering [validFrom, validTo] or [validFrom, present]."
              }
            }
          }
        }
      }
    },
    "stations": {
      "type": "array",
      "description": "Optional stations list for F7 station filtering",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "domain": { "type": "string" },
          "description": { "type": "string" },
          "isActive": { "type": "boolean" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}