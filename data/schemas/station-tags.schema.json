{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Station Tags Schema",
  "description": "Valid station tags configuration for Genetech",
  "type": "object",
  "required": [
    "stations"
  ],
  "properties": {
    "stations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "slug"],
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label"],
              "properties": {
                "label": {
                  "type": "string"
                },
                "category": {
                  "type": "string"
                },
                "weight": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  }
}