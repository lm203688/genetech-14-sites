# === Cloudflare ===
CLOUDFLARE_ACCOUNT_ID=替换为新ID
CLOUDFLARE_API_TOKEN=替换为新Token
CLOUDFLARE_ZONE_ID=替换为新ZoneID

# === GitHub ===
GITHUB_USERNAME=你的GitHub用户名
GITHUB_TOKEN=ghp_替换为新PAT

# === Creem 支付 ===
CREEM_STORE_ID=替换为商店ID
CREEM_API_KEY=替换为新APIKey
