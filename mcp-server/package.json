    "glama.json"
  ],
  "scripts": {
    "start": "node src/index.mjs",
    "smoke": "node ../../.workbuddy/probe/mcp-smoke.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node src/index.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "knowledge-base",
    "genetech",
    "ai-agent",
    "semantic-search",
    "citation",
    "citation-gaps",
    "research-gap",
    "cross-domain"
  ]
}
